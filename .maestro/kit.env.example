# Copy to .maestro/kit.env and edit. Read by every script in .maestro/scripts/.
# One KEY=VALUE per line, no quotes. Lines starting with # are ignored.
# kit.env is git-ignored: it may contain machine-specific paths.

# Android application id (package name). Also used by init.* to replace
# com.example.app in every flow file.
APP_ID=com.example.app

# How build-install.* produces the APK:
#   flutter  - flutter build apk --debug --target-platform <emulator ABI>
#   expo     - npx expo run:android --variant release (JS is bundled, no Metro needed)
#   gradle   - ./gradlew assembleDebug (native Android / bare React Native)
#   apk      - no build, install APK_PATH as is
FRAMEWORK=flutter

# Path to the APK, relative to the repo root. Leave empty to use the
# framework's default output path. Required when FRAMEWORK=apk.
APK_PATH=

# Flutter only: build variant. debug starts slowly (first screen up to 30 s)
# but needs no signing. profile is closer to release timing.
FLUTTER_VARIANT=debug

# A screenshot smaller than this (KB) is flagged as "possibly blank": it was
# probably taken before the first frame was painted. 25 KB fits a 900x1600
# emulator; raise it for high-DPI devices, lower it for small screens.
BLANK_PNG_KB=25

# Artifact folders older than this many days are deleted by cleanup.*.
KEEP_DAYS=7
