# Copy this file to .maestro/.env and fill in the values.
# .maestro/.env is git-ignored and must never be committed.
#
# Every key MUST start with MAESTRO_ : run.* puts these into the process
# environment and Maestro exposes MAESTRO_* variables to flows as ${MAESTRO_...}.
# Values are taken literally (no quotes needed), one KEY=VALUE per line.
#
# Use dedicated TEST accounts on a dev/staging backend. Never real users,
# never production.

# Default test account (used by smoke/01_tabs.yaml)
MAESTRO_TEST_EMAIL=test@example.com
MAESTRO_TEST_PASSWORD=

# Add more accounts as your flows need them, e.g. one per subscription tier:
# MAESTRO_PRO_EMAIL=
# MAESTRO_PRO_PASSWORD=
